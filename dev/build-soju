#!/bin/sh
# Builds the soju trout uses (install.SojuVersion). Pure Go (moderncsqlite,
# no cgo), so it runs anywhere without packages. For Linux it also builds
# trout-cert (cmd/trout-cert), which trout uploads with soju to get the
# bouncer a Let's Encrypt certificate; that one is rebuilt every time.
#
#   dev/build-soju                     into the cache install.FindFor looks in:
#                                      linux amd64, arm64 and arm, to install
#                                      on servers, and this computer's, for
#                                      running its own (This Computer)
#   dev/build-soju DIR os/arch...      into DIR/os-arch/ instead, plus soju's
#                                      LICENSE (AGPL) and where its source is
#                                      (the release does this)
set -e
cd "$(dirname "$0")/.."
version=$(sed -n 's/^const SojuVersion = "\(.*\)"$/\1/p' internal/install/install.go)
[ -n "$version" ] || { echo "can't find SojuVersion in internal/install/install.go" >&2; exit 1; }
if [ $# -gt 0 ]; then
	cache=$1
	shift
	platforms=$*
else
	cache=$(go run ./dev/cachedir)/trout/soju/$version
	platforms="linux/amd64 linux/arm64 linux/arm $(go env GOOS)/$(go env GOARCH)"
fi
modcache=$(go env GOMODCACHE)
tmp=$(mktemp -d)
trap 'chmod -R u+w "$tmp"; rm -rf "$tmp"' EXIT
for platform in $platforms; do
	os=${platform%/*} arch=${platform#*/}
	out=$cache/$os-$arch
	if [ -n "$(ls "$out"/soju "$out"/soju.exe 2>/dev/null)" ]; then
		echo "soju $version $os/$arch: already built in $out"
		continue
	fi
	echo "soju $version $os/$arch..."
	# GOARM=6 for 32-bit ARM: every Raspberry Pi, the Pi 1 and Zero included.
	GOOS=$os GOARCH=$arch GOARM=6 CGO_ENABLED=0 GOBIN= GOPATH=$tmp/gopath GOMODCACHE=$modcache \
		go install -trimpath -ldflags='-s -w' -tags moderncsqlite \
		codeberg.org/emersion/soju/cmd/soju@"$version" codeberg.org/emersion/soju/cmd/sojuctl@"$version"
	mkdir -p "$out"
	bin=$tmp/gopath/bin/${os}_$arch
	[ -d "$bin" ] || bin=$tmp/gopath/bin # this computer's own: no subfolder
	mv "$bin"/soju* "$out/"
	chmod -R u+w "$tmp/gopath/bin"
	rm -r "$tmp/gopath/bin"
	echo "  -> $out"
done
for platform in $platforms; do
	os=${platform%/*} arch=${platform#*/}
	[ "$os" = linux ] || continue
	GOOS=linux GOARCH=$arch GOARM=6 CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o "$cache/$os-$arch/trout-cert" ./cmd/trout-cert
	echo "trout-cert $os/$arch -> $cache/$os-$arch"
done
# soju is AGPL: its license, and where to get the exact source, go with it.
src=$(GOFLAGS=-mod=mod go mod download -json codeberg.org/emersion/soju@"$version" | sed -n 's/^[[:space:]]*"Dir": "\(.*\)",$/\1/p')
install -m 644 "$src/LICENSE" "$cache/SOJU-LICENSE" # read-only in the module cache
cat >"$cache/SOJU-SOURCE.md" <<EOT
The soju-*/ folders hold soju $version, an IRC bouncer by Simon Ser and
contributors, licensed under the GNU AGPL v3 (SOJU-LICENSE). trout runs it
as a separate program, unchanged, built with (and GOARM=6 for 32-bit ARM):

    CGO_ENABLED=0 go install -trimpath -ldflags='-s -w' -tags moderncsqlite \\
        codeberg.org/emersion/soju/cmd/soju@$version codeberg.org/emersion/soju/cmd/sojuctl@$version

Its source: https://codeberg.org/emersion/soju/src/tag/$version

The soju-linux-*/ folders also hold trout-cert, trout's own helper (MIT,
like trout; cmd/trout-cert), which gets the bouncer a Let's Encrypt
certificate on its server.
EOT
