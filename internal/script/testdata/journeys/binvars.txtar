Binary variables: what mIRC 7.86 did with /bset, /bcopy, /breplace, $bvar,
$bfind, hashes and $encode (tmp/bin-oracle.mrc and bin-oracle2.mrc), and that
they last for one run: an alias sees its caller's, a timer doesn't. /bread and
/bwrite (b4) follow the help file: mIRC's test copy hangs loading a script with
/bwrite in it.

-- bin.mrc --
alias fill { bset &shared 1 1 2 3 }
alias b1 {
  bset &a 1 65 66 67
  echo -s 01 len= $+ $bvar(&a,0) vals= $+ $bvar(&a,1,3) one= $+ $bvar(&a,2) text= $+ $bvar(&a,1,3).text all= $+ $bvar(&a,1-)
  bset &a 6 70
  echo -s 02 len= $+ $bvar(&a,0) vals= $+ $bvar(&a,1,6) text= $+ $bvar(&a,1,6).text
  bset -t &b 1 hello world
  echo -s 03 len= $+ $bvar(&b,0) text= $+ $bvar(&b,1,$bvar(&b,0)).text past= $+ $bvar(&b,1,50).text start7= $+ $bvar(&b,7).text
  bset -t &c 1 é
  bset -ta &d 1 é
  echo -s 04 utf8= $+ $bvar(&c,1,$bvar(&c,0)) ansi= $+ $bvar(&d,1,$bvar(&d,0)) ctext= $+ $bvar(&c,1,2).text dtext= $+ $bvar(&d,1,1).text
  bset &n 1 65 0 66
  echo -s 05 nulltext= $+ $bvar(&n,1,3).text
  bset -c &a 2 90
  echo -s 06 chop len= $+ $bvar(&a,0) vals= $+ $bvar(&a,1,$bvar(&a,0))
  bset -z &z 4 65 66
  echo -s 07 z len= $+ $bvar(&z,0)
  bunset &a
  echo -s 08 unset=< $+ $bvar(&a,0) $+ > missing=< $+ $bvar(&missing,1) $+ >
  fill
  echo -s 09 shared-from-alias len= $+ $bvar(&shared,0)
  .timer 1 0 echo -s 10 timer-later=< $!+ $!bvar(&shared,0) $!+ >
}
alias b2 {
  bset -t &b 1 hello world
  bcopy &d2 1 &b 1 5
  echo -s 11 bcopy text= $+ $bvar(&d2,1,$bvar(&d2,0)).text len= $+ $bvar(&d2,0)
  bcopy &d2 3 &b 7 5
  echo -s 12 bcopy-mid text= $+ $bvar(&d2,1,$bvar(&d2,0)).text len= $+ $bvar(&d2,0)
  bset -t &d3 1 abcdefgh
  bcopy -c &d3 2 &b 1 2
  echo -s 13 bcopy-c text= $+ $bvar(&d3,1,$bvar(&d3,0)).text
  bset -t &d4 1 abcdef
  bcopy -z &d5 1 &d4 2 3
  echo -s 14 bcopy-z src= $+ $bvar(&d4,1,6) dst= $+ $bvar(&d5,1,3).text
  bset -t &r 1 hello world
  breplace &r 111 48 108 76
  echo -s 15 breplace text= $+ $bvar(&r,1,$bvar(&r,0)).text
  echo -s 16 bfind o= $+ $bfind(&b,1,111) w= $+ $bfind(&b,1,w).text wor= $+ $bfind(&b,1,wor).text from6= $+ $bfind(&b,6,111) none= $+ $bfind(&b,1,zzz).text num= $+ $bfind(&b,1,104 101) two= $+ $bfind(&b,1,108 108) upper= $+ $bfind(&b,1,W)
  bset &w 1 1 2 3 4
  echo -s 17 word= $+ $bvar(&w,1).word nword= $+ $bvar(&w,1).nword long= $+ $bvar(&w,1).long nlong= $+ $bvar(&w,1).nlong
  echo -s 18 range2= $+ $bvar(&b,2-) past=< $+ $bvar(&b,20) $+ > partial=< $+ $bvar(&b,10,5) $+ > partialtext= $+ $bvar(&b,10,5).text
}
alias b3 {
  bset -t &u 1 héllo
  echo -s 25 utf8-len= $+ $bvar(&u,0) text= $+ $bvar(&u,1,$bvar(&u,0)).text partial= $+ $bvar(&u,1,2).text
  bset &big 1 1
  bset &big 5000 2
  echo -s 26 big len= $+ $bvar(&big,0)
  bset -t &b 1 hello world
  echo -s 27 sha1= $+ $sha1(&b,1) md5= $+ $md5(&b,1) crc= $+ $crc(&b,1)
  noop $encode(&b,mb)
  echo -s 29 encode text= $+ $bvar(&b,1,$bvar(&b,0)).text
  noop $decode(&b,mb)
  echo -s 30 decode text= $+ $bvar(&b,1,$bvar(&b,0)).text
  bset -t &sp 1 a  b
  echo -s 32 spaces len= $+ $bvar(&sp,0) vals= $+ $bvar(&sp,1,4)
  bset &mix 1 72 -t i
  echo -s 33 mix len= $+ $bvar(&mix,0) vals= $+ $bvar(&mix,1,5)
  bset &e 1 300
  echo -s 34 wraps= $+ $bvar(&e,1) name= $+ $bvar(&e)
}
alias b4 {
  bset -t &b 1 hello world
  write -c bin.bin
  bwrite bin.bin 0 -1 &b
  bread bin.bin 6 5 &rr
  echo -s 40 bread= $+ $bvar(&rr,1,$bvar(&rr,0)).text len= $+ $bvar(&rr,0)
  bwrite bin.bin -1 -1 !!
  echo -s 41 appended= $+ $read(bin.bin,n,1)
  bwrite bin.bin 0 2 HEy
  echo -s 42 two= $+ $read(bin.bin,n,1)
  bwrite -c bin.bin 0 3 &b
  echo -s 43 chopped= $+ $read(bin.bin,n,1) size= $+ $file(bin.bin).size
  btrunc bin.bin 2
  echo -s 44 trunc= $+ $read(bin.bin,n,1) size= $+ $file(bin.bin).size
  btrunc bin.bin 4
  bread bin.bin 0 10 &t
  echo -s 45 padded= $+ $bvar(&t,1,10)
}
alias e1 bset &e 0 65
alias e2 bset &e 1
alias e3 bcopy &new 1 &missing 1 3
alias e4 echo -s $bvar(&b,1,2,3)
